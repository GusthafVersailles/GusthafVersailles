{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/atelier-noir",
      "destination": "/projetos/AtelierNoir/index.html",
      "permanent": true
    },
    {
      "source": "/font-pairing",
      "destination": "/projetos/FontPairing/index.html",
      "permanent": true
    },
    {
      "source": "/elegant-fonts",
      "destination": "/projetos/ElegantFonts/index.html",
      "permanent": true
    },
    {
      "source": "/Projects/AtelierNoir/index.html",
      "destination": "/projetos/AtelierNoir/index.html",
      "permanent": true
    },
    {
      "source": "/Projects/FontPairing/index.html",
      "destination": "/projetos/FontPairing/index.html",
      "permanent": true
    },
    {
      "source": "/Projects/ElegantFonts/index.html",
      "destination": "/projetos/ElegantFonts/index.html",
      "permanent": true
    },
    {
      "source": "/Projects/ElegantFonts/footer/contato.html",
      "destination": "/projetos/ElegantFonts/footer/contato.html",
      "permanent": true
    },
    {
      "source": "/Projects/ElegantFonts/footer/privacidade.html",
      "destination": "/projetos/ElegantFonts/footer/privacidade.html",
      "permanent": true
    },
    {
      "source": "/Projects/ElegantFonts/footer/sobre.html",
      "destination": "/projetos/ElegantFonts/footer/sobre.html",
      "permanent": true
    },
    {
      "source": "/elegant-fonts/contato",
      "destination": "/projetos/ElegantFonts/footer/contato.html",
      "permanent": true
    },
    {
      "source": "/elegant-fonts/privacidade",
      "destination": "/projetos/ElegantFonts/footer/privacidade.html",
      "permanent": true
    },
    {
      "source": "/elegant-fonts/sobre",
      "destination": "/projetos/ElegantFonts/footer/sobre.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/inicio",
      "destination": "/index.html"
    },
    {
      "source": "/sobre",
      "destination": "/index.html"
    },
    {
      "source": "/processo",
      "destination": "/index.html"
    },
    {
      "source": "/obras",
      "destination": "/index.html"
    },
    {
      "source": "/contato",
      "destination": "/index.html"
    }
  ]
}
